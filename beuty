<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Salão Bela Unha • Beleza, Estilo e Cuidado</title>
  <meta name="description" content="Salão Bela Unha — alongamento em gel, blindagem, nail art e spa das mãos. Produtos profissionais e atendimento personalizado." />
  <meta name="theme-color" content="#ff4dc6" />

  <!-- Fonte moderna -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg: #0a0a0f;           /* fundo escuro futurista */
      --panel: rgba(255,255,255,0.06); /* vidro */
      --border: rgba(255,255,255,0.18);
      --txt: #f6f6f7;
      --muted: #c9c9d1;
      --brand: #ff4dc6;        /* rosa neon */
      --brand-2: #7cf5ff;      /* ciano neon */
      --ok: #7CFF8B;
      --warning: #ffd166;
      --shadow: 0 10px 30px rgba(0,0,0,.35);
    }

    * { box-sizing: border-box; }
    html, body { height: 100%; }
    body {
      margin: 0;
      font-family: 'Poppins', system-ui, -apple-system, Segoe UI, Roboto, Ubuntu, 'Helvetica Neue', Arial, sans-serif;
      color: var(--txt);
      background: radial-gradient(1200px 800px at 80% -20%, rgba(255,77,198,.20), transparent 60%),
                  radial-gradient(1200px 800px at -20% 110%, rgba(124,245,255,.18), transparent 60%),
                  #07070b;
      overflow-x: hidden;
    }

    /* Fundo animado (constelação) */
    .stars {
      position: fixed; inset: 0; z-index: -2; pointer-events: none; opacity: .6;
      background: repeating-radial-gradient(circle at 30% 40%, #fff1 0 2px, transparent 3px 60px),
                  repeating-radial-gradient(circle at 70% 60%, #fff1 0 2px, transparent 3px 80px);
      animation: twinkle 10s linear infinite;
      filter: drop-shadow(0 0 4px #fff5);
    }
    @keyframes twinkle { to { transform: translateY(-20px); opacity: .75; } }

    /* Grade fluida e utilidades */
    .container { width: min(1200px, 92vw); margin: 0 auto; }
    .grid { display: grid; gap: 24px; }
    .grid-2 { grid-template-columns: repeat(2, minmax(0,1fr)); }
    .grid-3 { grid-template-columns: repeat(3, minmax(0,1fr)); }
    @media (max-width: 960px){ .grid-3 { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 720px){ .grid-2, .grid-3 { grid-template-columns: 1fr; } }

    /* Cartões glass/neon */
    .card {
      background: var(--panel);
      -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
      border: 1px solid var(--border);
      border-radius: 20px; padding: 22px; box-shadow: var(--shadow);
      position: relative; isolation: isolate; overflow: hidden;
    }
    .card::before {
      content: ""; position: absolute; inset: -1px; border-radius: 20px; z-index: -1;
      background: conic-gradient(from 180deg, var(--brand), transparent 30%, var(--brand-2), transparent 62%, var(--brand));
      filter: blur(24px); opacity: .25; animation: ring 8s linear infinite;
    }
    @keyframes ring { to { transform: rotate(360deg); } }

    /* Botões */
    .btn {
      display:inline-flex; align-items:center; gap:10px; justify-content:center;
      padding: 14px 20px; border-radius: 14px; border: 1px solid var(--border);
      color: var(--txt); background: linear-gradient(180deg, #ffffff0c, #ffffff05);
      text-decoration: none; font-weight: 600; letter-spacing: .2px; cursor: pointer;
      transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }
    .btn:hover { transform: translateY(-2px); box-shadow: 0 10px 26px rgba(255,77,198,.15); border-color: #ffffff35; }
    .btn.primary { background: linear-gradient(90deg, var(--brand), var(--brand-2)); color:#0a0a0f; }

    /* Cabeçalho */
    header {
      position: sticky; top: 0; z-index: 50; backdrop-filter: blur(12px);
      background: linear-gradient(180deg, rgba(7,7,11,.75), rgba(7,7,11,.35) 70%, transparent);
      border-bottom: 1px solid #ffffff12;
    }
    .topbar { display:flex; align-items:center; justify-content:space-between; gap:16px; padding: 16px 0; }
    .brand { display:flex; align-items:center; gap: 12px; font-weight: 800; letter-spacing: .3px; font-size: clamp(18px, 2vw, 22px); }
    .brand .logo { width: 34px; height: 34px; border-radius: 10px; background: linear-gradient(135deg, var(--brand), var(--brand-2)); box-shadow: 0 0 16px #ff4dc655; }
    nav ul { display:flex; gap: 6px; list-style:none; margin:0; padding:0; }
    nav a { 
      padding: 10px 14px; border-radius: 12px; color: var(--muted); text-decoration:none; font-weight:600; font-size: 14px;
      transition: color .2s ease, background .2s ease;
    }
    nav a:hover { color: var(--txt); background: #ffffff0f; }
    .actions { display:flex; align-items:center; gap: 12px; }

    /* Herói */
    .hero { position: relative; padding: 72px 0 60px; }
    .hero .halo { position:absolute; inset: -10% -20% auto -20%; height: 70%; z-index:-1; opacity:.55;
      background: radial-gradient(800px 480px at 70% 20%, rgba(255,77,198,.25), transparent 40%),
                  radial-gradient(800px 480px at 30% 50%, rgba(124,245,255,.2), transparent 45%);
      filter: blur(20px);
    }
    .hero h1 { font-size: clamp(28px, 4.8vw, 64px); line-height: 1.05; margin: 0 0 14px; font-weight: 900; letter-spacing: -0.5px; }
    .hero p { margin: 0 0 24px; color: var(--muted); font-size: clamp(14px, 1.4vw, 18px); }
    .badges { display:flex; flex-wrap: wrap; gap: 10px; margin: 18px 0; }
    .badge { font-size: 12px; padding: 8px 12px; border-radius: 999px; border: 1px solid var(--border); background: #ffffff0a; color: var(--muted); }

    .hero-media { position: relative; }
    .hero-media .phone {
      width: 100%; aspect-ratio: 10/7; border-radius: 24px; overflow:hidden; border:1px solid var(--border);
      background: url('https://images.unsplash.com/photo-1616690710400-a16d1430a6d4?q=80&w=1600&auto=format&fit=crop') center/cover no-repeat;
      box-shadow: 0 30px 60px rgba(0,0,0,.35), 0 0 0 1px #ffffff11 inset;
      animation: float 6s ease-in-out infinite;
    }
    @keyframes float { 0%,100%{ transform: translateY(0) } 50%{ transform: translateY(-10px) } }

    /* Seções */
    section { padding: 56px 0; }
    .section-head { display:flex; align-items:end; justify-content:space-between; gap: 16px; margin-bottom: 18px; }
    .kicker { letter-spacing: .2em; font-weight: 700; color: var(--brand-2); font-size: 12px; text-transform: uppercase; }
    .title { font-size: clamp(20px, 3.2vw, 36px); margin: 6px 0 10px; font-weight: 800; }
    .subtitle { color: var(--muted); max-width: 760px; }

    /* Serviços */
    .service { display:flex; gap: 16px; }
    .service .icon { width: 46px; height: 46px; border-radius: 12px; display:grid; place-items:center;
      background: linear-gradient(135deg, #ffffff0e, #ffffff06); border:1px solid var(--border);
    }

    /* Produtos (cards) */
    .product-card { display:flex; flex-direction:column; gap:12px; }
    .product-thumb { border-radius: 16px; overflow:hidden; border:1px solid var(--border); aspect-ratio: 4/3; background:#111; position:relative; }
    .product-thumb img { width:100%; height:100%; object-fit:cover; display:block; filter: saturate(1.05) contrast(1.02); }
    .price { font-weight: 800; font-size: 18px; }
    .pill { display:inline-block; font-size:12px; color:#0a0a0f; background: linear-gradient(90deg, var(--brand), var(--brand-2)); padding:6px 10px; border-radius:999px; font-weight:700; }

    /* Galeria */
    .gallery { --size: 180px; display:grid; grid-template-columns: repeat(auto-fill, minmax(var(--size), 1fr)); gap:12px; }
    .gallery img { width:100%; height:160px; object-fit:cover; border-radius:14px; border:1px solid var(--border); transition: transform .3s ease; }
    .gallery img:hover { transform: scale(1.03); }

    /* Depoimentos / Frases inspiracionais */
    .quote { font-size: clamp(16px, 2vw, 22px); line-height: 1.4; color: var(--muted); }
    .quote b { color: var(--txt); }

    /* Formulário */
    form { display:grid; gap: 12px; }
    label { font-size: 14px; color: var(--muted); }
    input, textarea { width:100%; padding:14px 16px; border-radius: 14px; border:1px solid var(--border); background:#0e0e15; color:var(--txt); outline:none; }
    input:focus, textarea:focus { border-color: #ffffff42; box-shadow: 0 0 0 4px #ffffff10; }

    /* Rodapé */
    footer { border-top:1px solid #ffffff12; padding: 32px 0; color: var(--muted); }

    /* Scroll reveal */
    [data-reveal] { opacity: 0; transform: translateY(14px) scale(.98); transition: opacity .6s ease, transform .6s ease; }
    [data-reveal].is-visible { opacity: 1; transform: none; }

    /* Toggle tema */
    .theme-toggle { width:44px; height:44px; border-radius:12px; border:1px solid var(--border); background:#ffffff0a; display:grid; place-items:center; cursor:pointer; }
    .theme-toggle svg { width:20px; height:20px; }

    /* Modo claro */
    .light {
      --bg: #f9f9fb; --panel:#ffffffea; --border:#00000018; --txt:#101015; --muted:#51515b; --shadow: 0 10px 30px rgba(10,10,15,.08);
      background: radial-gradient(1200px 800px at 80% -20%, rgba(255,77,198,.10), transparent 60%),
                  radial-gradient(1200px 800px at -20% 110%, rgba(124,245,255,.10), transparent 60%),
                  #f3f5f8;
    }
    .light .btn.primary { color:white; }
  </style>
</head>
